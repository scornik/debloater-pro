<?xml version="1.0"?>
<ruleset name="Debloater Pro">
	<description>
		The free plugin's standard, applied to Pro.

		Deliberately the same ruleset rather than a lighter one. Pro is the half
		of this product that touches a payment platform, and the argument for
		holding it to a lower bar than the half that does not would have to be
		made out loud to survive being written down here.

		The exclusions below are the free plugin's, kept where they apply, plus
		the ones Pro's own code needs. Each says why.
	</description>

	<file>src</file>
	<file>tests</file>
	<file>debloater-pro.php</file>

	<!--
		The Freemius SDK is third-party code that ships inside this plugin. It
		is held to its own standards by the people who wrote it, and reporting
		on it here would bury Pro's own results under several thousand lines
		about somebody else's formatting.
	-->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor/freemius/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 file names, because the autoloader requires them. -->
		<exclude name="WordPress.Files.FileName"/>

		<!-- camelCase methods, matching the free plugin and PSR-12. -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>

		<!-- "WordPress" appears in prose about WordPress. -->
		<exclude name="WordPress.WP.CapitalPDangit.MisspelledInText"/>

		<!-- The file comment is the class docblock in a one-class-per-file tree. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
	</rule>

	<rule ref="WordPress-VIP-Go"/>

	<rule ref="PHPCompatibilityWP">
		<exclude name="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext"/>
	</rule>

	<config name="testVersion" value="8.1-"/>

	<!--
		Pro's own text domain, matching its slug. wordpress.org serves
		translations per slug, so a string carrying the free plugin's domain
		would be a string that never arrives translated here.
	-->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="debloater-pro"/>
			</property>
		</properties>
	</rule>

	<!--
		Everything below is about the tests, and about one property of them: they
		run with no WordPress loaded. `tests/bootstrap-pro.php` defines six
		duration constants and nothing else, on purpose — Pro extends Debloater
		through documented hooks rather than by calling into it, so its units are
		testable with nothing installed.

		The sniffs excluded here all prefer a WordPress wrapper over a PHP
		function. In a file that runs without WordPress the wrapper does not
		exist, so the preference is not advice, it is an error.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Performance.FetchingRemoteData">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!--
		The architecture tests read source files and assert things about their
		contents. That is the whole method: the thing being defended is a
		*location* — which file may name the licensing platform, which may name
		the cloud host — and a location is not something a runtime assertion can
		check.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>

<?xml version="1.0"?>
<ruleset name="Debloater Pro">
	<description>The free plugin's standard, applied to Pro.</description>

	<file>src</file>
	<file>tests</file>
	<file>debloater-pro.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="debloater-pro"/>
			</property>
		</properties>
	</rule>

	<config name="testVersion" value="8.1-"/>
</ruleset>

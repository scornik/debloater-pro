# Everything in pro/ that is not the Pro plugin.
#
# One of these files per plugin root, read by `scripts/plugin-zip.mjs` and by
# the WordPress tooling that looks for it. Pro is packaged from `pro/`, so its
# exclusions are written relative to `pro/` and not to the repository root —
# the free plugin's `.distignore` says nothing about this directory and cannot
# be made to.

# Version control and CI
.git
.gitignore
.gitattributes
.github
.distignore

# Tests and their harness. Pro's tests live in the repository's own tests/
# tree; this entry is here so that a test placed alongside the source later
# cannot ship by being forgotten about.
tests
phpunit.xml.dist
.phpunit.cache
.phpunit.result.cache

# Development apparatus
node_modules
package.json
package-lock.json
composer.json
composer.lock
phpcs.xml.dist
phpstan.neon

# Local environment
.wp-env.json
.wp-env.override.json

# Licensing configuration is not distributable.
#
# `config/freemius.php` holds the store's own identifiers. The secret half of
# those must never appear in a package (BUILD-SPEC §13 rule 15), so the file is
# excluded here before it exists rather than after somebody notices it in a
# zip. Part 2 adds the file and `vendor/freemius/` — the SDK itself *does*
# ship, and is not listed here.
config/freemius.php

# Assorted
*.log
*.zip
.DS_Store
Thumbs.db
dist
